# ---------------------------------------------------------------------------
# Mehfil Backend — Environment (development)
# Copy to .env and adjust. NEVER commit real production secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=api

# Public URLs (used in emails, QR payloads, redirects)
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api
WEB_URL=http://localhost:3000

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:3000,http://192.168.1.19:8081

# Database (native PostgreSQL on this machine)
DATABASE_URL=postgresql://mehfil:mehfil_dev_password@127.0.0.1:5432/mehfil?schema=public

# Redis (native on this machine)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Auth / JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_production_9f2c1a
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production_7b4e8d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Email (SMTP). In dev, MAIL_DRIVER=log just prints to console.
MAIL_DRIVER=log
MAIL_HOST=smtp.joinmehfil.co
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@joinmehfil.co
MAIL_PASSWORD=change_me
MAIL_FROM="Mehfil <no-reply@joinmehfil.co>"

# Google Workspace email (client-provided) — used for transactional mail in prod
SUPPORT_EMAIL=support@joinmehfil.co

# Media uploads (Phase 1: local disk under /uploads served statically)
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200

# Payments (Phase 1: mock + manual). Set PROVIDER=mock
PAYMENT_PROVIDER=mock
PLATFORM_FEE_PERCENT=5
DEFAULT_CURRENCY=PKR

# Feature flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_AGE_GATE=true
MIN_AGE=13
