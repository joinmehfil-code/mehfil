# ---------------------------------------------------------------------------
# Mehfil Backend — PRODUCTION environment template (Railway).
# Copy these into the Railway "backend" service → Variables tab.
# The ${{Service.VAR}} syntax is Railway's reference to a plugin/service; set
# them in the dashboard (do NOT commit real secrets).
# ---------------------------------------------------------------------------

NODE_ENV=production
# Railway injects the real PORT at runtime; 4000 is only a local fallback.
PORT=4000
API_PREFIX=api

# --- Public URLs (used in emails, QR payloads, redirects) --------------------
APP_URL=https://joinmehfil.co
WEB_URL=https://joinmehfil.co
API_URL=https://api.joinmehfil.co/api

# --- CORS: comma-separated allowed origins (web + any preview domains) -------
CORS_ORIGINS=https://joinmehfil.co,https://www.joinmehfil.co

# --- Database: Railway Postgres plugin (use the PRIVATE url inside Railway) --
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Redis: Railway Redis plugin --------------------------------------------
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_HOST=
REDIS_PORT=

# --- Auth / JWT: generate long random unique secrets ------------------------
# e.g. `openssl rand -hex 32` for each. NEVER reuse the dev values.
JWT_ACCESS_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_BYTE_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# --- Email (transactional): Brevo / Resend / Google Workspace SMTP ----------
MAIL_DRIVER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-login@example.com
MAIL_PASSWORD=your-smtp-key
MAIL_FROM="Mehfil <no-reply@joinmehfil.co>"
SUPPORT_EMAIL=support@joinmehfil.co

# --- Media: persistent Railway volume mounted at /data/uploads --------------
UPLOAD_DRIVER=local
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=200

# --- Payments (Phase 1: mock + manual approval) -----------------------------
PAYMENT_PROVIDER=mock
PLATFORM_FEE_PERCENT=5
DEFAULT_CURRENCY=PKR

# --- Feature flags ----------------------------------------------------------
ENABLE_EMAIL_VERIFICATION=true
ENABLE_AGE_GATE=true
MIN_AGE=13
