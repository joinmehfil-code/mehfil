# ---------------------------------------------------------------------------
# Mehfil Mobile (Expo) — PRODUCTION public config.
# EXPO_PUBLIC_* are inlined at BUILD time by EAS. These same values are also
# set in eas.json per build profile, so you normally don't need this file on
# CI; it's here for local `expo run`/production testing.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_APP_NAME=Mehfil
EXPO_PUBLIC_API_URL=https://api.joinmehfil.co/api
EXPO_PUBLIC_SOCKET_URL=https://api.joinmehfil.co/rt
