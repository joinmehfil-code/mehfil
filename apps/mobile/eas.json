{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Mehfil",
        "EXPO_PUBLIC_API_URL": "https://api.joinmehfil.co/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.joinmehfil.co/rt"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Mehfil",
        "EXPO_PUBLIC_API_URL": "https://api.joinmehfil.co/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.joinmehfil.co/rt"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Mehfil",
        "EXPO_PUBLIC_API_URL": "https://api.joinmehfil.co/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.joinmehfil.co/rt"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "joinmehfil@gmail.com",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      }
    }
  }
}
