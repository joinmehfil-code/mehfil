# ---------------------------------------------------------------------------
# Mehfil Web (Next.js) — PRODUCTION environment template (Railway).
# NEXT_PUBLIC_* are INLINED AT BUILD TIME, so set these as Railway variables
# BEFORE the build runs. Point them at your backend's public domain.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=Mehfil
NEXT_PUBLIC_API_URL=https://api.joinmehfil.co/api
NEXT_PUBLIC_SOCKET_URL=https://api.joinmehfil.co/rt
NEXT_PUBLIC_WEB_URL=https://joinmehfil.co

# Only used by the dev rewrite proxy (/api/backend/*). Leave EMPTY in prod so
# no rewrite is generated (the browser calls the API origin directly).
NEXT_PUBLIC_API_PROXY_TARGET=
